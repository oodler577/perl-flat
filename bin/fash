#!/usr/bin/env perl
use strict;
use warnings;
use FindBin qw($RealBin);
use lib "$RealBin/../lib";
use FLAT::CLI;
use Encode qw(decode FB_CROAK);
binmode STDIN, ':encoding(UTF-8)';
binmode STDOUT, ':encoding(UTF-8)';
binmode STDERR, ':encoding(UTF-8)';
my @args;
eval { @args = map { decode('UTF-8', $_, FB_CROAK) } @ARGV; 1 }
    or do { print STDERR "fash: arguments must be valid UTF-8\n"; exit 2 };
exit FLAT::CLI->run(@args);
